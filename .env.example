# 登录凭据（必填）
AUTH_USER=trader
AUTH_PASSWORD_HASH=

# 刷新时间表（市场本地时间，每天三个窗口）
REFRESH_TIMES_CN=09:30,13:00,14:45
REFRESH_TIMES_US=09:30,12:00,15:45
REFRESH_OPEN_OFFSET_SECS=60
REFRESH_COOLDOWN_SECS=60
SNAPSHOT_RETENTION=30
STALE_AFTER_SECS=21600
MAX_CONCURRENCY=4

# 部署
LSTOCK_IMAGE=ghcr.io/ggflyjean/l-stock:latest
LSTOCK_PORT=18084
LSTOCK_DATA_DIR=./data

# 出站代理（可选，容器通常只允许主动出站）
# HTTPS_PROXY=http://proxy:3128
# HTTP_PROXY=http://proxy:3128

# 行情源覆盖（一般不需要改）
TENCENT_BASE_URL=https://qt.gtimg.cn
SINA_BASE_URL=https://hq.sinajs.cn
EASTMONEY_BASE_URL=https://push2.eastmoney.com
EASTMONEY_DATACENTER_BASE_URL=https://datacenter-web.eastmoney.com
EASTMONEY_PUSH2EX_BASE_URL=https://push2ex.eastmoney.com
YAHOO_BASE_URL=https://query1.finance.yahoo.com
STOOQ_BASE_URL=https://stooq.com
